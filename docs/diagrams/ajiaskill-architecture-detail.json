  "cards": [
    {
      "dot": "cyan",
      "title": "MCP is pull-based",
      "items": [
        "The server exposes ajia_search and ajia_use; it never reads the user message.",
        "The host/model decides when to call the tools."
      ]
    },
    {
      "dot": "emerald",
      "title": "Native-first",
      "items": [
        "hosts.json and install.sh put core skills in ~/.agents/skills and host roots.",
        "A native match wins; ajia_use refuses a duplicate fallback."
      ]
    },
    {
      "dot": "rose",
      "title": "Promotion is separate",
      "items": [
        "Scan security, PII, lint, and license before promotion.",
        "Promotion is manual, locked, and reversible."
      ]
    }
  ]
