  "cards": [
    {
      "dot": "emerald",
      "title": "Native first",
      "items": [
        "Installed skill descriptions are available before any MCP call.",
        "A native match wins; ajia_use refuses a duplicate fallback."
      ]
    },
    {
      "dot": "cyan",
      "title": "Search is read-only",
      "items": [
        "ajia_search returns metadata: id, description, license, risk, native_hosts.",
        "It filters to enabled profile sources and marks native duplicates."
      ]
    },
    {
      "dot": "rose",
      "title": "Use is not install",
      "items": [
        "ajia_use copies exact bytes to a content-addressed store and records a 30-day trial.",
        "Promotion needs ajia promote and explicit user approval."
      ]
    },
    {
      "dot": "violet",
      "title": "Wire OpenCode",
      "items": [
        "opencode mcp add --global ajiaskill -- python bin/ajia mcp --host opencode",
        "initialize carries the advisory trigger policy."
      ]
    }
  ]
