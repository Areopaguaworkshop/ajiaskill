    {
      "dot": "cyan",
      "title": "Inputs",
      "items": [
        "A repo, a document, a URL, or the workflow just completed.",
        "Inspect first and redact secrets before writing."
      ]
    },
    {
      "dot": "emerald",
      "title": "Candidate is not installed",
      "items": [
        "The foundry entry is indexed with generated_by: foundry and curator_state: candidate.",
        "ajia generated lists it; ajia use returns a read-only body and a 30-day trial."
      ]
    },
    {
      "dot": "violet",
      "title": "Hermes path",
      "items": [
        "ajia learn --execute, or hermes chat then /learn <source>, then ajia source sync hermes.",
        "Hermes created_by and curator_state come from ~/.hermes/skills/.usage.json."
      ]
    },
    {
      "dot": "rose",
      "title": "Hard rules",
      "items": [
        "Never auto-promote. Scan before promote.",
        "Never copy into .agents/skills or .claude/skills; that is installation."
