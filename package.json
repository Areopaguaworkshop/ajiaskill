{
  "name": "ajiaskill",
  "version": "0.1.6",
  "description": "Personal skill manager and platform for coding agents: catalog, MCP, native-first routing, and gated promotion.",
  "license": "MIT",
  "author": "ajia",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Areopaguaworkshop/ajiaskill.git"
  },
  "homepage": "https://github.com/Areopaguaworkshop/ajiaskill#readme",
  "bugs": {
    "url": "https://github.com/Areopaguaworkshop/ajiaskill/issues"
  },
  "bin": {
    "ajiaskill": "npm/ajia.js",
    "ajia": "npm/ajia.js",
    "ajiaskill-mcp": "npm/ajiaskill-mcp.js"
  },
  "files": [
