#!/usr/bin/env python3
"""ajia — local skill platform.

Catalog skill sources, search them, use a skill without installing it, and
expose search/use over MCP. Standard library only.
"""
from __future__ import annotations

import argparse
import hashlib
import json
import math
import os
import re
import shlex
import shutil
import subprocess
import sys
from collections import Counter
from urllib.parse import urlencode, urlparse
from urllib.request import Request, urlopen
from datetime import datetime, timedelta, timezone
from pathlib import Path
from typing import Any

VERSION = "0.1.3"
REPO_ROOT = Path(__file__).resolve().parent.parent
POLICY = (
    "Prefer an installed native skill when it matches. Core triggers: "
    "architecture/workflow/sequence/ERD/diagram or a visual explainer -> archify; "
    "one-page HTML answer -> answer-me-with-html; browser/login/form -> browser-skill; "
    "app verification/evidence -> create-verification-skill; "
    "frontend/UI/design -> impeccable; GUI/desktop automation -> cua-driver; "
    "OpenShell policy_denied -> openshell-policy-advisor; "
    "terse mode -> caveman; smallest complete change -> ponytail; "
    "ADHD-shaped output -> i-have-adhd; "
    "RTK/Rust CLI work -> rtk-triage, pr-review, pr-triage, security-guardian, "
    "performance, code-simplifier, design-patterns, rtk-tdd, tdd-rust, ship, "
    "issue-triage, repo-recap. "
    "When no native skill clearly matches, call `ajia_search` once before improvising. "
    "If a result fits, call `ajia_use` and follow the returned `SKILL.md` in place; "
    "do not copy, install, or promote anything unless the user explicitly asks."
)
SKIP_DIRS = {".git", "__pycache__", "node_modules", ".venv", "venv", ".archive", ".hub"}
SKIP_FILES = {".DS_Store"}
STORE_SCHEMA = 1
NAME_RE = re.compile(r"^[a-z0-9]+(?:-[a-z0-9]+)*$")
SCAN_SUFFIXES = {
    ".md", ".txt", ".py", ".sh", ".bash", ".zsh", ".js", ".mjs", ".ts",
    ".json", ".yaml", ".yml", ".toml", ".ini", ".cfg", ".env",
}
SCRIPT_SUFFIXES = {".sh", ".bash", ".zsh", ".py", ".js", ".mjs", ".ts"}
SCAN_RULES = [
    ("critical", "remote-exec", re.compile(r"\b(curl|wget)\b[^\n|]{0,200}\|\s*(bash|sh|zsh)\b", re.I)),
    ("high", "prompt-injection", re.compile(r"\b(ignore (all )?previous|disregard (all )?previous|do not tell the user|developer mode|system prompt)\b", re.I)),
    ("high", "credential-access", re.compile(r"(~/\.ssh|\.aws/credentials|id_rsa|keychain|browser cookies|gh auth token|GITHUB_TOKEN)", re.I)),
    ("high", "remote-instructions", re.compile(r"(fetch|download|read).{0,60}https?://.{0,60}(instruction|prompt|script)", re.I)),
    ("medium", "dynamic-exec", re.compile(r"\b(eval|exec|subprocess|os\.system)\s*\(", re.I)),
    ("low", "network", re.compile(r"https?://|169\.254\.169\.254|webhook", re.I)),
    ("high", "secret", re.compile(r"(AKIA[0-9A-Z]{16}|ghp_[A-Za-z0-9]{36}|-----BEGIN [A-Z ]*PRIVATE KEY-----)")),
]


class SkillError(RuntimeError):
    pass


def safe_http_url(url: str) -> str:
    """Allow https anywhere and http only on loopback (for local tests)."""
    parsed = urlparse(url)
    if parsed.scheme not in {"http", "https"} or not parsed.hostname:
        raise SkillError("only http(s) URLs are supported")
    if parsed.username or parsed.password:
        raise SkillError("URL credentials are not allowed")
    if parsed.scheme == "http" and parsed.hostname not in {"127.0.0.1", "localhost", "::1"}:
        raise SkillError("http is only allowed on loopback")
    return url


def safe_id(value: str) -> str:
    return re.sub(r"[^A-Za-z0-9._-]+", "__", value)


def now_iso() -> str:
    return datetime.now(timezone.utc).replace(microsecond=0).isoformat()


def home_path(value: str | None) -> Path:
    if value:
        return Path(value).expanduser().resolve()
    env = os.environ.get("AJIA_HOME")
    if env:
        return Path(env).expanduser().resolve()
    return (Path.home() / ".ajia").resolve()


def paths(home: Path) -> dict[str, Path]:
    return {
        "home": home,
        "sources": home / "sources.yaml",
        "catalog": home / "catalog",
        "manifest": home / "catalog" / "manifest.json",
        "skills": home / "catalog" / "skills.jsonl",
        "store": home / "store",
        "trials": home / "trials",
        "scans": home / "scans",
        "foundry": home / "foundry",
        "source_cache": home / "sources",
        "lock": home / "ajia.lock.json",
    }


def ensure_dirs(home: Path) -> None:
    p = paths(home)
    for key in ("catalog", "store", "trials", "scans", "foundry", "source_cache"):
        p[key].mkdir(parents=True, exist_ok=True)


